# Puerto del servidor
PORT=5000

# Cadena de conexión a MongoDB (local o Atlas)
MONGO_URI=mongodb://localhost:27017/caa_app

# Clave secreta para firmar tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_segura
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (frontend)
CLIENT_URL=http://localhost:5173
